[Unit]
Description=B3 Storefront AI Shopping Assistant (Single Worker)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/b3-bot
EnvironmentFile=/opt/b3-bot/.env
Environment="BOT_STORE_CONFIG_DIR=/opt/b3-bot/stores"
Environment="BOT_EVENTS_DIR=/opt/b3-bot/events"
# IMPORTANT: Run exactly 1 worker because rate limiters, concurrency gate, and Ringg webhook dedupe are in-memory.
# Bind only to loopback (127.0.0.1) or a private VPC interface reachable only by mw/API.
ExecStart=/opt/b3-bot/.venv/bin/uvicorn --factory bot.server:create_app --host 127.0.0.1 --port 8100 --workers 1 --no-access-log
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
